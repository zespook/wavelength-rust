{
  "name": "wavelength",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\start-local.ps1",
    "dev:dioxus": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts\\start-local.ps1",
    "build:dioxus": "node scripts/build-dioxus.mjs",
