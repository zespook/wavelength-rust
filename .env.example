# Optional host port for the room-only API (default: 5050).
ROOM_SERVER_PORT=5050

# Required: use a unique, high-entropy passcode of at least 16 characters.
ROOM_SERVER_PASSCODE=

# Optional comma-separated proxy IPs trusted to set X-Real-IP for client rate limits.
ROOM_SERVER_TRUSTED_PROXIES=

# Set to the deployed web app origin (without a path) when hosting the frontend.
# Local Dioxus development origins on port 8080 are allowed by default.
FRONTEND_URL=

# Spotify OAuth values for the room server. Register the callback URI in the Spotify developer dashboard.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:5050/api/spotify/callback
