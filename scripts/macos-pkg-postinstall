#!/bin/bash
set -euo pipefail

TARGET_VOLUME="${2:-/}"
APP_EXECUTABLE="$TARGET_VOLUME/Applications/Wavelength.app/Contents/MacOS/wavelength"

if [[ ! -x "$APP_EXECUTABLE" ]]; then
	echo "The installed Wavelength application executable was not found." >&2
	exit 1
fi

CONSOLE_USER="$(stat -f %Su /dev/console)"
if [[ "$CONSOLE_USER" == "root" || "$CONSOLE_USER" == "loginwindow" ]]; then
	exit 0
fi

/usr/bin/sudo -u "$CONSOLE_USER" "$APP_EXECUTABLE" --install-services
